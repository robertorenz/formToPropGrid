    #PROMPT('&Sort rows alphabetically',CHECK),%PGStyleSort,DEFAULT(0),AT(10)
  #ENDBOXED
  #BOXED('Name column font')
    #PROMPT('Fa&ce:',@s32),%PGFontNameFace,DEFAULT('Segoe UI'),REQ
    #PROMPT('Si&ze (pt):',SPIN(@n3,6,48,1)),%PGFontNameSize,DEFAULT(9)
    #PROMPT('B&old',CHECK),%PGFontNameBold,DEFAULT(0),AT(10)
  #ENDBOXED
  #BOXED('Value column font')
    #PROMPT('Fac&e:',@s32),%PGFontValFace,DEFAULT('Segoe UI'),REQ
    #PROMPT('Size (&pt):',SPIN(@n3,6,48,1)),%PGFontValSize,DEFAULT(9)
    #PROMPT('Bol&d',CHECK),%PGFontValBold,DEFAULT(0),AT(10)
  #ENDBOXED
  #BOXED('Category header font')
    #PROMPT('F&ace:',@s32),%PGFontCatFace,DEFAULT('Segoe UI'),REQ
