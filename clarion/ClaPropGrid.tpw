#!-----------------------------------------------------------------------------
#! %PGStyleNumber - the PGS_xxx bit mask as a NUMBER, evaluated at generate
#! time so the emitted call carries a plain literal.
#!-----------------------------------------------------------------------------
#GROUP(%PGStyleNumber)
  #RETURN(%PGStyleBorder + 2 * %PGStyleDesc + 4 * %PGStyleToolbox + 8 * %PGStyleSort)
#!
#!-----------------------------------------------------------------------------
#! %PGEmitAppearance(object) - the SetFont / SetColor / metric calls.
#! Emitted at column 5 (inside the generated IF ... END block).
#!-----------------------------------------------------------------------------
#GROUP(%PGEmitAppearance,%pObj)
    %pObj.SetFont(PGF:Name,'%PGFontNameFace',%PGFontNameSize,%PGFontNameBold,0)
    %pObj.SetFont(PGF:Value,'%PGFontValFace',%PGFontValSize,%PGFontValBold,0)
    %pObj.SetFont(PGF:Category,'%PGFontCatFace',%PGFontCatSize,%PGFontCatBold,0)
    %pObj.SetFont(PGF:Desc,'%PGFontValFace',%PGFontValSize,0,0)
    %pObj.SetColor(PGC:Back,%PGColBack)
    %pObj.SetColor(PGC:NameBack,%PGColNameBack)
    %pObj.SetColor(PGC:NameText,%PGColNameText)
    %pObj.SetColor(PGC:ValueText,%PGColValueText)
    %pObj.SetColor(PGC:CatBack,%PGColCatBack)
    %pObj.SetColor(PGC:CatText,%PGColCatText)
    %pObj.SetColor(PGC:Lines,%PGColLines)
    %pObj.SetColor(PGC:SelBack,%PGColSelBack)
    %pObj.SetColor(PGC:SelText,%PGColSelText)
    %pObj.SetColor(PGC:DescBack,%PGColDescBack)
    %pObj.SetColor(PGC:DescText,%PGColDescText)
  #IF(%PGRowHeight)
    %pObj.SetRowHeight(%PGRowHeight)
  #ENDIF
  #IF(%PGSplitter)
    %pObj.SetSplitter(%PGSplitter)
  #ENDIF
#!  NOTE: the per-category fonts are NOT emitted here.  This group runs
#!  the moment the grid is created, before a single AddCategory has
#!  happened, so FindCategory would find nothing.  Each template calls
#!  %PGEmitCatFonts itself once every category exists.
#!
#!-----------------------------------------------------------------------------
#! %PGEmitCatFonts(object) - the per-category font overrides.
#!
#! FindCategory returns 0 for a name that does not exist and
#! SetCategoryFontFace does nothing with a category of 0, so a mistyped
#! name is a no-op - no empty header, no error.  The PGF: equate is
#! written out per branch instead of through a %() group call, because a
#! group call from inside a #FOR over a MULTI list expands empty and
#! silently kills the whole enclosing #AT (INSTALL.md section 7).
#!-----------------------------------------------------------------------------
#GROUP(%PGEmitCatFonts,%pObj)
  #FOR(%PGCatFont),WHERE(%PGCatFontName AND (%PGCatFontFace OR %PGCatFontSize OR %PGCatFontBold OR %PGCatFontItalic))
    #CASE(%PGCatFontWhich)
    #OF('Category header')
    %pObj.SetCategoryFontFace(%pObj.FindCategory('%PGCatFontName'),PGF:Category,'%PGCatFontFace',%PGCatFontSize,%PGCatFontBold,%PGCatFontItalic)
    #OF('Name column')
    %pObj.SetCategoryFontFace(%pObj.FindCategory('%PGCatFontName'),PGF:Name,'%PGCatFontFace',%PGCatFontSize,%PGCatFontBold,%PGCatFontItalic)
    #ELSE
    %pObj.SetCategoryFontFace(%pObj.FindCategory('%PGCatFontName'),PGF:Value,'%PGCatFontFace',%PGCatFontSize,%PGCatFontBold,%PGCatFontItalic)
    #ENDCASE
  #ENDFOR
#!
#!-----------------------------------------------------------------------------
#! %PGEditorEquate(editor text) - map the DROP choice to the PGT: equate.
#!-----------------------------------------------------------------------------
#GROUP(%PGEditorEquate,%pEditor)
  #CASE(%pEditor)
