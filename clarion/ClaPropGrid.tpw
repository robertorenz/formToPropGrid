    #RETURN('PGT:Password')
  #OF('Drop list')
    #RETURN('PGT:Drop')
  #OF('Checkbox')
    #RETURN('PGT:Check')
  #OF('Radio')
    #RETURN('PGT:Radio')
  #OF('Slider')
    #RETURN('PGT:Slider')
  #OF('Spin')
    #RETURN('PGT:Spin')
  #OF('Button')
    #RETURN('PGT:Button')
  #OF('Color')
    #RETURN('PGT:Color')
  #OF('Date')
    #RETURN('PGT:Date')
  #OF('Time')
    #RETURN('PGT:Time')
  #OF('Multiline')
    #RETURN('PGT:MultiText')
  #OF('Read only')
    #RETURN('PGT:ReadOnly')
  #ELSE
    #RETURN('PGT:Text')
  #ENDCASE
