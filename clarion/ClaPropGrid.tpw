#!=============================================================================
#!  ClaPropGrid.tpw  -  shared #GROUPs for the ClaPropGrid template set.
#!  #INCLUDEd from ClaPropGrid.tpl.  Nothing but #GROUPs lives in here, and
#!  a #GROUP has no end marker, so this file must contain NO #AT / #EMBED.
#!=============================================================================
#!
#!-----------------------------------------------------------------------------
#! %PGAppearancePrompts - style / font / metric prompts.  #INSERTed by BOTH
#! templates, so the symbol names are deliberately shared.
#!-----------------------------------------------------------------------------
#GROUP(%PGAppearancePrompts)
  #BOXED('Grid style')
    #PROMPT('Thin &border',CHECK),%PGStyleBorder,DEFAULT(1),AT(10)
    #PROMPT('&Description pane at the bottom',CHECK),%PGStyleDesc,DEFAULT(1),AT(10)
