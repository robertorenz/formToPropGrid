LIBRARY PROPGRID
; Ordinals are a public contract: the Clarion import library
; (clarion\propgrid.lib) references them, so NEVER renumber or reuse
; an ordinal.  New exports get the next free number, appended below.
EXPORTS
    PG_Initialize      @1
    PG_Shutdown        @2
    PG_Create          @3
    PG_Destroy         @4
    PG_SetPos          @5
    PG_GetHwnd         @6
    PG_SetFont         @7
    PG_SetColor        @8
    PG_SetRowHeight    @9
    PG_SetSplitter     @10
    PG_GetSplitter     @11
    PG_Clear           @12
    PG_AddCategory     @13
    PG_AddProperty     @14
    PG_SetChoices      @15
    PG_SetRange        @16
    PG_SetDescription  @17
    PG_SetReadOnly     @18
    PG_SetExpanded     @19
    PG_SetTag          @20
    PG_GetTag          @21
    PG_SetValue        @22
    PG_GetValue        @23
    PG_GetRowCount     @24
    PG_FindRow         @25
    PG_GetSelected     @26
    PG_PollEvent       @27
    PG_SetCallback     @28
    PG_Redraw          @29
;   ---- v1.2: per-category / per-row fonts ----
    PG_AddFont         @30
    PG_GetFontCount    @31
    PG_GetFont         @32
    PG_SetCatFont      @33
    PG_GetCatFont      @34
    PG_SetRowFont      @35
    PG_GetRowFont      @36
    PG_SetRowFontFace  @37
    PG_SetCatFontFace  @38
;   ---- v1.2: wrapped multi-line value rows ----
    PG_SetRowWrap      @39
    PG_GetRowWrap      @40
    PG_GetRowHeight    @41
    PG_FindCategory    @42
